import sys

def load_ranking(file_path):
    ranking = {}
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if "：" in line:
                    pref, rank = line.split("：")
                elif ":" in line:
                    pref, rank = line.split(":")
                else:
                    continue
                ranking[pref.strip()] = rank.strip()
    except:
        pass
    return ranking


def main():
    ranking = load_ranking("ranking.txt")
    ok = True

    for line in sys.stdin:
        pref = line.strip()

        if pref == "":
            print("")
            ok = False
            break

        if pref in ranking:
            print(f"{pref} の魅力度ランキングは {ranking[pref]} 位です")
        else:
            print(f"{pref} は 都道府県名または漢字ではありません")
            ok = False
            break

    if ok:
        sys.exit(0)
    else:
        sys.exit(1)


if __name__ == "__main__":
    main()

